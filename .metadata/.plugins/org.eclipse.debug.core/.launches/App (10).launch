    <booleanAttribute key="org.eclipse.jdt.launching.ATTR_EXCLUDE_TEST_CODE" value="true"/>
    <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="interface_examples.App"/>
    <stringAttribute key="org.eclipse.jdt.launching.MODULE_NAME" value="interface_examples"/>
    <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="interface_examples"/>
</launchConfiguration>

package treeset_comparable;

public class Employee {
	public class Mobile implements Comparable<Mobile>{
		int id;
		String model;
		double price;
		public Mobile(int id,String name,double price) {
			this.id=id;
			this.name=name;
			this.price=price;
		}
		@Override
		public int compareTo(Mobile o) {
			int result=this.id-o.id;
			return result;
		}
	}

}

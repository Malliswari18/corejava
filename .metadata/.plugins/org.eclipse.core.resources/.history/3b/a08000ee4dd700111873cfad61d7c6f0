package treeset_comparable;
import java.util.*;
public class Mobile {
	public class Mobile implements Comparable<Mobile>{
		int id;
		String model;
		double price;
		public Mobile(int id,String name,double price, String model) {
			this.id=id;
			this.model=model;
			this.price=price;
		}
		/* sorting based on model*/
		@Override
		public int compareTo(Mobile o) {
			int result=this.id-o.id;
			return result;
		}
		@Override
		public String toString() {
			return "mobile:"+id +model+price;
		}
	}

}

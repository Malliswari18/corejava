package hashmap;
import java.util.*;
public class Example1 {
	public static void main(String[] args) {
		HashMap<Integer,String> cities=new HashMap<Integer,String>();
		cities.put(577528, "davangere");
		cities.put(577432, "bagalore");
		cities.put(577528, "dshivmogga");
		cities.put(560089, "Bangalore");
		cities.put(560070, "davangere");
		System.out.println(cities);
		Set<Integer> keys=cities.Keyset();
		for(int i:keys) {
			System.out.println(i+"->"+cities.get(i));
		}
		
	}

}
